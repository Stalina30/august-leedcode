class Solution {
    public int majorityElement(int[] nums) {
        HashMap<Integer,Integer> m=new HashMap<>();
        int n=nums.length;
        int i=n/2;
        for(int a:nums){
            int b=m.getOrDefault(a,0)+1;
            m.put(a,b);
        if(b>i){
            return a;
        }
        
    }
    return -1;
    }
}
